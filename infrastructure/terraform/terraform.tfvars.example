# Copy to terraform.tfvars (git-ignored) and adjust only what differs from the defaults.

aws_region        = "us-east-1"
availability_zone = "us-east-1a"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidr  = "10.20.1.0/24"
private_subnet_cidr = "10.20.2.0/24"

create_private_subnet = false

# --- Day 02: NX-DC01 ---------------------------------------------------------
# Step 1: apply Day 01 with create_dc = false.
# Step 2: run automation/aws-cli/day02-preflight.sh, then set create_dc = true.
create_dc                 = false
dc_instance_type          = "t3.medium"
dc_cpu_credits            = "unlimited"
dc_root_volume_size_gb    = 50
dc_private_ip             = "10.20.1.10"
dc_termination_protection = true
# dc_ami_id               = "ami-0123456789abcdef0"  # optional pin; default = latest from SSM

# --- Day 02: DHCP option set -------------------------------------------------
# Step 3: only after NX-DC01 is promoted and DNS is validated.
ad_domain_name         = "nexora.local"
enable_ad_dhcp_options = false
# dhcp_dns_servers     = ["10.20.1.10", "10.20.0.2"]  # default when null
